{
  "name": "rpcs3-web-probe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile Safari capability and runtime bring-up harness for RPCS3.",
  "packageManager": "yarn@4.13.0+sha512.5c20ba010c99815433e5c8453112165e673f1c7948d8d2b267f4b5e52097538658388ebc9f9580656d9b75c5cc996f990f611f99304a2197d4c56d21eea370e7",
  "scripts": {
    "prepare:assets": "node scripts/stage-coi.mjs",
    "postinstall": "yarn prepare:assets",
    "dev": "vite --host 0.0.0.0",
    "build": "yarn prepare:assets && tsc --noEmit && vite build",
    "build:core": "bash scripts/build-core.sh",
    "build:runtime": "bash scripts/build-rpcs3-core.sh",
    "commercial:headless": "node scripts/run-hardware-acceptance.mjs",
    "ppu:aot": "node scripts/compile-ppu-ir-to-wasm.mjs",
    "ppu:aot:fixture": "node scripts/build-ppu-aot-fixture.mjs",
    "ppu:aot:bundle": "node scripts/build-ppu-aot-bundle.mjs",
    "spu:aot:bundle": "node scripts/build-spu-aot-bundle.mjs",
    "spu:aot:fixture": "node scripts/build-spu-aot-fixture.mjs",
    "dispatch:build": "node scripts/build-dispatch-fixture.mjs",
    "dispatch:native": "node scripts/run-dispatch-conformance.mjs",
    "storage:inspect": "node scripts/inspect-opfs.mjs",
    "storage:import-host": "node scripts/import-host-opfs.mjs",
    "compare:frame": "node scripts/compare-native-webgpu-frame.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:gpu": "playwright test --config playwright.gpu.config.ts",
    "test:packet-fixture": "playwright test --config playwright.gpu.config.ts packet-replay.spec.ts",
    "test:units:browser": "yarn build && playwright test browser-units.spec.ts",
    "device:wip": "node scripts/run-wip-device.mjs",
    "device:runtime": "node scripts/run-full-runtime-device.mjs",
    "device:units": "node scripts/run-unit-device.mjs",
    "check": "yarn test && yarn build",
    "device:origin": "node scripts/run-origin-device.mjs",
    "device:library": "node scripts/run-library-device.mjs",
    "library:serve": "node scripts/serve-library.mjs",
    "hardware:run": "node scripts/run-hardware-acceptance.mjs"
  },
  "dependencies": {
    "@appmana-public/disc-images": "https://github.com/AppMana/web-emulator-kit.git#workspace=@appmana-public/disc-images&commit=742b7b9aef1a1531807dbf187947fdf057f85f56",
    "@appmana-public/web-emulator-harness": "https://github.com/AppMana/web-emulator-kit.git#workspace=@appmana-public/web-emulator-harness&commit=742b7b9aef1a1531807dbf187947fdf057f85f56"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "@types/pngjs": "^6.0.5",
    "@webgpu/types": "0.1.64",
    "playwright": "1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
